{
  "color": {
    "ink": "#0B080D",
    "inkSoft": "#1F1F21",
    "bronze": "#7E5F35",
    "champagne": "#DCC9AB",
    "paper": "#F7F4EB",
    "paperRaised": "#FFFFFF",
    "paperSunk": "#F1EDE2",
    "rule": "#DAD3C4",
    "muted": "#6E6A63",
    "error": "#8C2F22"
  },
  "colorRules": {
    "accentOnLight": "bronze",
    "accentOnDark": "champagne",
    "never": [
      "champagne on paper (1.47:1)",
      "bronze on ink for text (3.39:1)"
    ]
  },
  "font": {
    "display": "\"Cormorant Garamond\", Georgia, serif",
    "text": "\"Montserrat\", \"Helvetica Neue\", Arial, sans-serif",
    "arabic": "\"IBM Plex Sans Arabic\", sans-serif",
    "displayMinPx": 20
  },
  "fontSize": {
    "display": "clamp(2rem, 1.1rem + 2.6vw, 3.4rem)",
    "h1": "clamp(2rem, 1.4rem + 2.2vw, 3.1rem)",
    "h2": "clamp(1.5rem, 1.2rem + 1.1vw, 2rem)",
    "h3": "1.2rem",
    "lead": "clamp(1.05rem, 1rem + 0.35vw, 1.3rem)",
    "body": "1.0625rem",
    "small": "0.9375rem",
    "label": "0.6875rem"
  },
  "lineHeight": {
    "display": 1.08,
    "heading": 1.2,
    "body": 1.65,
    "serif": 1.5
  },
  "letterSpacing": {
    "label": "0.22em",
    "wordmark": "0.34em",
    "arabicLabel": "0"
  },
  "layout": {
    "measure": "68ch",
    "rail": "168px",
    "pageMax": "1180px",
    "gutter": "clamp(1.25rem, 4vw, 4rem)",
    "radius": "2px"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4.5rem",
    "9": "7rem"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "duration": "180ms",
    "note": "Motion answers user actions only. No scroll-triggered entrances."
  },
  "breakpoints": {
    "mobile": "640px",
    "tablet": "860px",
    "desktop": "1024px"
  },
  "logo": {
    "minSizeFullPx": 32,
    "minSizeFullMm": 11,
    "belowMinimum": "assets/logo-compact.svg",
    "clearSpace": "one flute width on all sides"
  }
}
